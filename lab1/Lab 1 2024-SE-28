    "def caught_speeding(speed, is_birthday):\n",
    "    if is_birthday:\n",
    "        speed -= 5\n",
    "        \n",
    "    if speed <= 60:\n",
    "        return \"No Ticket\"\n",
    "    elif 61 <= speed <= 80:\n",
    "        return \"Small Ticket\"\n",
    "    else:\n",
    "        return \"Big Ticket\"\n",
    "\n",
    "# Test cases:\n",
    "print(caught_speeding(81, True))   # Small Ticket (81 - 5 = 76)\n",
    "print(caught_speeding(81, False))  # Big Ticket (81)"
   ]
